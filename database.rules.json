{
  "rules": {
    "system": {
      ".read": "auth != null",
      ".write": "auth.uid === 'DEVICE_UID_HERE'",
      "manualToggle": {
        ".write": "auth != null && newData.val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "history": { ".read": "auth != null", ".write": "auth.uid === 'DEVICE_UID_HERE'" },
    "config": { ".read": "auth != null", ".write": "auth.uid === 'DEVICE_UID_HERE'" }
  }
}
