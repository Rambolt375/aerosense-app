{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "dart-mcp-server": {
            "type": "local",
            "command": [
                "dart",
                "mcp-server"
            ],
            "enabled": true
        },
        "firebase": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "firebase-tools@latest",
                "mcp"
            ],
            "enabled": false
        }
    }
}